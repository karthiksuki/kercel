.venv/
__pycache__/
*.py[cod]
*$py.class
cdk.out/
.pytest_cache/
.mypy_cache/
.env
.env.*

# BUG-20 FIX: cdk.context.json stores AZ/subnet lookups that are resolved
# against a specific AWS account and region at `cdk synth` time.  Committing
# this file means every developer or CI pipeline in a *different* account will
# silently reuse stale cached values (wrong AZs, wrong subnet IDs) until they
# manually run `cdk context --clear`.  Each environment should resolve its own
# context fresh.  The file is auto-regenerated by `cdk synth` on first run.
cdk.context.json
